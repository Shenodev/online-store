{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --workspace=shenostore-frontend",
  "installCommand": "npm install",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "has": [{ "type": "host", "value": "api.store.shenodev.tech" }],
      "destination": "https://api-store-shenodev-backend.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.store.shenodev.tech" }],
      "destination": "/admin/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "store.shenodev.tech" }],
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
