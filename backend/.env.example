# Copy these into your shell / secret manager. NEVER commit real values.
# Aiven console -> Service -> Connection string (MySQL, TLS required).
MYSQL_URL=jdbc:mysql://<aiven-host>:<port>/<db>?ssl-mode=REQUIRED&serverTimezone=UTC&useUnicode=true&characterEncoding=utf8mb4
MYSQL_USER=<aiven-user>
MYSQL_PASSWORD=<aiven-password>
DB_POOL_SIZE=5
DB_MIN_IDLE=2
JWT_SECRET=<256-bit-random-secret>
CORS_ORIGINS=https://store.shenodev.tech,https://admin.store.shenodev.tech
ADMIN_BASE_URL=https://admin.store.shenodev.tech
INVITE_TTL_HOURS=72
# SMTP (optional — unset MAIL_HOST keeps mock log-only sends)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shenodev.tech
PORT=8080
